rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection:
    // Any authenticated user can read user profiles (needed for staff list and finding own profile)
    // A user can create/update their own profile document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth != null);
    }

    // Jobs: any authenticated user can read and write
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    // Shifts
    match /shifts/{shiftId} {
      allow read, write: if request.auth != null;
    }

    // Technicians
    match /technicians/{techId} {
      allow read, write: if request.auth != null;
    }
  }
}
